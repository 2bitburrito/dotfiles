{
  "$schema": "https://opencode.ai/config.json",
  "logLevel": "DEBUG",
  "experimental": {
    "mcp_timeout": 5000
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "oauth": {
        "scope": "tools:read write"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ]
    }
  },
  "plugin": [
    "opencode-gemini-auth@latest",
    "opencode-with-claude"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    }
  },
  "permission": {
    "read": {
      "~/go/pkg/mod": "allow",
      "~/go/pkg/mod/**": "allow"
    },
    "edit": {
      "~/go/pkg/mod": "deny",
      "~/go/pkg/mod/**": "deny"
    },
    "external_directory": {
      "~/go/pkg/mod": "allow",
      "~/go/pkg/mod/**": "allow",
      "~/Documents/Projects/**": "allow"
    }
  }
}
